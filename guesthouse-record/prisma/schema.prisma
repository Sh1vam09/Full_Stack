// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Define the table structure here
model GuestMessage {
  id        String   @id @default(cuid())
  name      String
  message   String
  createdAt DateTime @default(now())
}